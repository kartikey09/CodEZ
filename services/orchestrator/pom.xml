<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>in.ac.iiitb</groupId>
    <artifactId>orchestrator</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>orchestrator</name>
    <description>Judge0 worker for the IIIT-B contest platform (Day 7: stream -> Judge0 -> verdict)</description>

    <properties>
        <java.version>21</java.version>
        <!-- standalone shades Jetty/Jackson/etc., so it can't collide with Spring Boot's copies -->
        <wiremock.version>3.9.2</wiremock.version>
        <!-- docker-java (via Testcontainers) still negotiates Docker API 1.32, which Engine 25+ rejects
             (minimum API 1.40), so the 'redis-it' profile pins a modern one. Override on an older engine:
             ./mvnw test -Predis-it -Ddocker.api.version=1.41 -->
        <docker.api.version>1.44</docker.api.version>
    </properties>

    <dependencies>
        <!-- Core Spring Boot, no servlet container: this is a worker, not a web server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- RestClient lives here; pulling spring-web directly avoids dragging in Tomcat -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- Jackson, so RestClient can (de)serialize JSON bodies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-json</artifactId>
        </dependency>

        <!-- Day 7: consume the subq stream, publish results, release the in-flight lock -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- Day 7: read source/tests + write verdicts via JdbcTemplate (orchestrator does NOT own the schema) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Bounded, self-evicting test-case cache (see TestCache); version managed by the Boot parent -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- P0-1: real-Redis end-to-end for the concurrent worker (SubmissionWorkerRedisIT, tagged 'redis',
             excluded from the default build). Versions come from the Spring Boot dependency BOM. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- The live Judge0 matrix is tagged 'judge0' and skipped by default (it needs a
                         running Judge0). The P0-1 real-Redis end-to-end is tagged 'redis' and skipped by
                         default (it needs a Docker daemon for Testcontainers). An explicit value here wins
                         over -DexcludedGroups, so each opt-in suite is run through its own profile:
                         ./mvnw test -Pjudge0-live     (live Judge0 matrix)
                         ./mvnw test -Predis-it        (real-Redis end-to-end) -->
                    <excludedGroups>judge0,chaos,redis</excludedGroups>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/Test*.java</include>
                        <include>**/*Tests.java</include>
                        <include>**/*TestCase.java</include>
                        <include>**/*IT.java</include>
                    </includes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-test-sources</id>
                        <phase>generate-test-sources</phase>
                        <goals><goal>add-test-source</goal></goals>
                        <configuration>
                            <sources>
                                <source>src/main/test/java</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Run the live Judge0 integration tests (needs Judge0 up on localhost:2358):
             ./mvnw test -Pjudge0-live
             JUDGE0_URL=http://localhost:2358 ./mvnw test -Pjudge0-live  (if on a different host) -->
        <profile>
            <id>judge0-live</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration combine.children="override">
                            <groups>judge0</groups>
                            <excludedGroups>__no_exclusions__</excludedGroups>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Run the P0-1 real-Redis end-to-end (needs a Docker daemon; Testcontainers starts redis:7-alpine):
             ./mvnw test -Predis-it -->
        <profile>
            <id>redis-it</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration combine.children="override">
                            <groups>redis</groups>
                            <excludedGroups>__no_exclusions__</excludedGroups>
                            <systemPropertyVariables>
                                <!-- docker-java's default (1.32) predates the engine's minimum API -->
                                <api.version>${docker.api.version}</api.version>
                            </systemPropertyVariables>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
